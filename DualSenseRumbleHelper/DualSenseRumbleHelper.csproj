<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- WinForms is kept only for a few dialogs (folder / colour picker) and the self-test message box. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DualSenseRumbleHelper</AssemblyName>
    <RootNamespace>DualSenseRumbleHelper</RootNamespace>
    <StartupObject>DualSenseRumbleHelper.Program</StartupObject>
    <Version>1.3.0</Version>
    <Product>DualSense Rumble Helper</Product>
    <Authors>Emiran404</Authors>
    <Company>Emiran404</Company>
    <Copyright>Copyright (c) 2026 Emiran404 · MIT License</Copyright>
    <Description>DualSense rumble for Rocket League on PC (Steam Input guide, ViGEmBus bridge, XInput proxy).</Description>
    <RepositoryUrl>https://github.com/Emiran404/DualSenseRumbleHelper</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Single, self-contained, installation-free exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF's XAML parser needs real culture data (InvariantGlobalization breaks it with "Cannot find non-neutral culture en-us"). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid System.Windows.Forms names clashing with WPF everywhere; files that need WinForms import it explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <!-- T("key") / F("key", args) for translated strings everywhere -->
    <Using Include="DualSenseRumbleHelper.Services.Loc" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native XInput proxy built by native\build_native.ps1 -->
    <EmbeddedResource Include="Resources\xinput_proxy.dll" LogicalName="xinput_proxy.dll" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
    <Resource Include="Resources\app.ico" />
    <!-- UI translations (one flat JSON per language) -->
    <EmbeddedResource Include="Resources\Lang\*.json" LogicalName="Lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="WPF-UI.Tray" Version="3.0.5" />
  </ItemGroup>

</Project>
