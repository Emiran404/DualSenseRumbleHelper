<ui:FluentWindow x:Class="DualSenseRumbleHelper.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:DualSenseRumbleHelper.UI.Pages"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:l="clr-namespace:DualSenseRumbleHelper.UI"
        Title="DualSense Rumble Helper"
        Width="1180" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DualSense Rumble Helper" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="250"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           FrameMargin="0"
                           Transition="FadeInWithSlide"
                           SelectionChanged="Nav_SelectionChanged">
            <ui:NavigationView.Header>
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Name="HeaderText" Margin="40,20,0,6" FontSize="26" FontWeight="SemiBold" Text="" />
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T nav.mode1}" TargetPageType="{x:Type pages:SteamPage}" Tag="1">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Games24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavBridge" Content="{l:T nav.mode2}" TargetPageType="{x:Type pages:BridgePage}" Tag="2">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="XboxController24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T nav.mode3}" TargetPageType="{x:Type pages:ProxyPage}" Tag="3">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentBulletList24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T nav.log}" TargetPageType="{x:Type pages:LogPage}" Tag="5">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="TextBulletListSquare24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T nav.settings}" TargetPageType="{x:Type pages:SettingsPage}" Tag="4">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- footer status bar -->
        <Border Grid.Row="2" Padding="16,6,16,8" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T footer.ready}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotPad" Width="8" Height="8" Margin="12,0,6,0" Fill="{DynamicResource TextFillColorDisabledBrush}" />
                    <TextBlock x:Name="FooterPad" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
                    <Ellipse x:Name="DotBridge" Width="8" Height="8" Margin="16,0,6,0" Fill="{DynamicResource TextFillColorDisabledBrush}" />
                    <TextBlock x:Name="FooterBridge" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
                </StackPanel>
            </Grid>
        </Border>

        <tray:NotifyIcon x:Name="Tray" Grid.Row="0" TooltipText="DualSense Rumble Helper" FocusOnLeftClick="True" MenuOnRightClick="True" Icon="pack://application:,,,/Resources/app.ico" LeftClick="Tray_LeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="{l:T tray.show}" Click="TrayShow_Click" FontWeight="SemiBold" />
                    <Separator />
                    <MenuItem x:Name="TrayStart" Header="{l:T tray.start}" Click="TrayStart_Click" />
                    <MenuItem x:Name="TrayStop" Header="{l:T tray.stop}" Click="TrayStop_Click" />
                    <Separator />
                    <MenuItem Header="{l:T tray.exit}" Click="TrayExit_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
