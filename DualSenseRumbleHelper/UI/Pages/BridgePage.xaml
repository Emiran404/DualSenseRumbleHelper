<Page x:Class="DualSenseRumbleHelper.UI.Pages.BridgePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:DualSenseRumbleHelper.UI"
      Title="ViGEm köprüsü">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,40,24">
        <StackPanel MaxWidth="1000">
            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="4,0,0,16"
                          Text="{l:T bridge.intro}" />

            <!-- Big start/stop card -->
            <Border CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="28" Margin="0,0,18,0" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="BigIcon" Symbol="XboxController24" FontSize="28" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Name="BigTitle" FontTypography="Subtitle" Text="" />
                        <ui:TextBlock x:Name="BigSub" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="" />
                        <TextBlock x:Name="LiveText" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="StartButton" Appearance="Primary" Content="{l:T bridge.start}" Icon="{ui:SymbolIcon Play24}" Margin="0,0,8,0" Click="Start_Click" />
                        <ui:Button x:Name="StopButton" Appearance="Danger" Content="{l:T bridge.stop}" Icon="{ui:SymbolIcon Stop24}" Margin="0,0,8,0" Click="Stop_Click" />
                        <ui:Button Content="{l:T bridge.test}" Icon="{ui:SymbolIcon Pulse24}" Click="Test_Click" ToolTip="{l:T bridge.testTip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- meters -->
            <Grid Margin="4,0,4,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T bridge.leftMeter}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="MeterLeft" Grid.Column="1" Minimum="0" Maximum="255" Height="6" VerticalAlignment="Center" />
                <ui:TextBlock Grid.Column="3" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T bridge.rightMeter}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="MeterRight" Grid.Column="4" Minimum="0" Maximum="255" Height="6" VerticalAlignment="Center" />
            </Grid>

            <ui:InfoBar x:Name="ConflictBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="{l:T bridge.conflictTitle}" Margin="0,0,0,12" />

            <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontTypography="BodyStrong" Text="{l:T bridge.requirements}" Margin="0,4,0,8" />
            <ui:CardControl Icon="{ui:SymbolIcon UsbPlug24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontTypography="Body" Text="{l:T bridge.vigem}" />
                        <ui:TextBlock x:Name="VigemText" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="…" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="VigemButton" Content="{l:T bridge.download}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="VigemDownload_Click" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontTypography="Body" Text="{l:T bridge.hidhide}" />
                        <ui:TextBlock x:Name="HidHideText" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="…" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:ToggleSwitch x:Name="HideToggle" Content="{l:T bridge.hide}" Margin="0,0,12,0" Click="HideToggle_Click" />
                    <ui:Button x:Name="HidHideButton" Content="{l:T bridge.download}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="HidHideDownload_Click" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Bluetooth24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontTypography="Body" Text="DualSense" />
                        <ui:TextBlock x:Name="PadText" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="…" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="4,12,0,0"
                          Text="{l:T bridge.footnote}" />
        </StackPanel>
    </ScrollViewer>
</Page>
